{
  "uid": "asignaciones-sre",
  "title": "Asignaciones · SRE",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "schemaVersion": 39,
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "SLI de asignación (objetivo ≥ 95%)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.98
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sli:asignacion:ratio_rate30s"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Presupuesto de error restante (5 min)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(1 - (1 - sli:asignacion:ratio_rate5m) / 0.05, 0)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Modo de asignación activo",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (modo) (rate(asignaciones_total[30s])) > 0",
          "legendFormat": "{{modo}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Alertas activas",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tráfico por respuesta (peticiones/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(asignaciones_total[30s]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latencia de asignación",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sli:asignacion:latencia_p95_1m",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(asignacion_duracion_seconds_bucket[1m])))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Tasa de errores del servidor",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(asignaciones_total{sli=\"mala\"}[30s])) / sum(rate(asignaciones_total{sli=~\"buena|mala\"}[30s]))",
          "legendFormat": "malas"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Pool de conexiones",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(db_pool_conexiones{estado=\"en_uso\"})",
          "legendFormat": "en uso"
        },
        {
          "refId": "B",
          "expr": "max(db_pool_conexiones{estado=\"esperando\"})",
          "legendFormat": "esperando"
        },
        {
          "refId": "C",
          "expr": "max(db_pool_tamano)",
          "legendFormat": "tamaño del pool"
        },
        {
          "refId": "D",
          "expr": "predict_linear(max(db_pool_conexiones{estado=\"en_uso\"})[2m:5s], 60)",
          "legendFormat": "pronóstico a 60 s"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Conexiones en PostgreSQL",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (pg_stat_activity_count{datname=\"asignaciones\"})",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Trazas lentas (más de 2 s)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ name =~ \".*asignaciones.*\" && duration > 2s }",
          "limit": 20
        }
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "Historia y KPIs · se calculan sobre el rango de tiempo elegido arriba a la derecha",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Cumplimiento del SLO en el periodo",
      "description": "KPI: % de peticiones válidas buenas en todo el rango elegido (no solo los últimos 30 s).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.98
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(asignaciones_total{sli=\"buena\"}[$__range])) / sum(increase(asignaciones_total{sli=~\"buena|mala\"}[$__range]))",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Presupuesto de error consumido",
      "description": "KPI: qué parte del 5% permitido se gastó en el periodo. Más de 100% = el SLO del periodo se incumplió.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 31,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(asignaciones_total{sli=\"mala\"}[$__range])) / (0.05 * sum(increase(asignaciones_total{sli=~\"buena|mala\"}[$__range])))",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Pico de saturación del pool",
      "description": "KPI de capacidad: pico de conexiones en uso / tamaño del pool. Sirve para dimensionar el siguiente semestre.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max_over_time(max(db_pool_conexiones{estado=\"en_uso\"})[$__range:5s]) / scalar(max(db_pool_tamano))",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Tiempo con el SLO incumplido",
      "description": "Duración total del incidente en el periodo, según el historial de la alerta reactiva.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 31,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum_over_time(max(ALERTS{alertname=\"SLOAsignacionIncumplido\",alertstate=\"firing\"})[$__range:5s]) * 5 or vector(0)",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Asignaciones exitosas en el periodo",
      "description": "Total de respuestas 201 en el rango.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(asignaciones_total{status=\"201\"}[$__range]))",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 17,
      "type": "stat",
      "title": "SLI por modo (antes vs después)",
      "description": "Compara la implementación inicial contra la atómica con todo lo que pasó en el rango.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 36,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.98
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (modo) (increase(asignaciones_total{sli=\"buena\"}[$__range])) / sum by (modo) (increase(asignaciones_total{sli=~\"buena|mala\"}[$__range]))",
          "instant": true,
          "range": false,
          "legendFormat": "{{modo}}"
        }
      ]
    },
    {
      "id": 18,
      "type": "stat",
      "title": "Latencia p95 por modo (antes vs después)",
      "description": "p95 de cada implementación en el rango.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, modo) (increase(asignacion_duracion_seconds_bucket[$__range])))",
          "instant": true,
          "range": false,
          "legendFormat": "{{modo}}"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Latencia p95: ahora vs hace $comparar",
      "description": "Tendencia: la misma métrica desplazada en el tiempo. Elija el desplazamiento en la variable 'Comparar con' de arriba.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sli:asignacion:latencia_p95_1m",
          "legendFormat": "p95 ahora"
        },
        {
          "refId": "B",
          "expr": "sli:asignacion:latencia_p95_1m offset $comparar",
          "legendFormat": "p95 hace $comparar"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "SLI: ahora vs hace $comparar",
      "description": "El mismo SLI desplazado en el tiempo, para comparar corridas o semestres.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 41,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sli:asignacion:ratio_rate1m",
          "legendFormat": "SLI ahora"
        },
        {
          "refId": "B",
          "expr": "sli:asignacion:ratio_rate1m offset $comparar",
          "legendFormat": "SLI hace $comparar"
        }
      ]
    }
  ],
  "tags": [
    "sre",
    "slo"
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Alertas disparadas",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\"}",
        "step": "5s",
        "titleFormat": "🔴 {{alertname}}",
        "textFormat": "Alerta {{severidad}}",
        "tagKeys": "severidad"
      },
      {
        "name": "Corrección activa (modo atómico)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "green",
        "expr": "sum(rate(asignaciones_total{modo=\"atomico\"}[30s])) > 0",
        "step": "5s",
        "titleFormat": "🟢 Modo atómico activo",
        "textFormat": "Feature flag modo_atomico = true"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "comparar",
        "label": "Comparar con",
        "type": "custom",
        "query": "5m,10m,15m,30m,1h,1d,7d",
        "current": {
          "text": "5m",
          "value": "5m",
          "selected": true
        },
        "options": [
          {
            "text": "5m",
            "value": "5m",
            "selected": true
          },
          {
            "text": "10m",
            "value": "10m",
            "selected": false
          },
          {
            "text": "15m",
            "value": "15m",
            "selected": false
          },
          {
            "text": "30m",
            "value": "30m",
            "selected": false
          },
          {
