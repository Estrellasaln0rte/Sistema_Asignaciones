# Copia este archivo a .env y ajusta los valores si hace falta.
POSTGRES_PASSWORD=app
# Conexiones del pool de la API: es la perilla del cuello de botella (supuesto del hito 1: 10)
POOL_SIZE=10
# Segundos que una petición espera una conexión libre antes de responder 503
POOL_TIMEOUT_S=5
# Feature flag de la corrección: false = implementación inicial, true = atómica.
# También se cambia en caliente con PUT /admin/flags
MODO_ATOMICO=false
